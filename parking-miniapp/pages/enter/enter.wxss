.container { padding: 24rpx; }

/* ============ 入场卡片 ============ */
.enter-card {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 50rpx 30rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
/* 顶部装饰渐变带 */
.enter-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, var(--brand-start) 0%, var(--brand-end) 50%, var(--ok) 100%);
}
.icon-area {
  font-size: 100rpx;
  margin-bottom: 10rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(91, 141, 239, 0.2));
}
.title { font-size: 36rpx; font-weight: bold; color: var(--ink); margin-bottom: 8rpx; }
.desc { font-size: 26rpx; color: var(--ink-2); margin-bottom: 40rpx; }

/* ============ 活动预约提示 ============ */
.reservation-hint {
  background: linear-gradient(135deg, var(--brand-tint) 0%, #E6F0FF 100%);
  border: 1rpx solid rgba(91, 141, 239, 0.3);
  border-left: 6rpx solid var(--brand-start);
  border-radius: var(--radius-card);
  padding: 16rpx 24rpx;
  margin-bottom: 30rpx;
  text-align: left;
}
.reservation-hint text {
  display: block;
  font-size: 28rpx;
  color: var(--brand-deep);
  font-weight: bold;
}
.hint-sub {
  font-size: 24rpx !important;
  color: var(--ink-2) !important;
  font-weight: normal !important;
  margin-top: 4rpx;
}

/* ============ 表单项 ============ */
.form-item { text-align: left; margin-bottom: 24rpx; }
.label {
  position: relative;
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  margin-bottom: 12rpx;
  padding-left: 16rpx;
  font-weight: 600;
}
.label::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 6rpx; height: 22rpx;
  background: linear-gradient(180deg, var(--brand-start) 0%, var(--brand-end) 100%);
  border-radius: 3rpx;
}
.picker-view {
  height: 88rpx;
  line-height: 88rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}
.picker-view.disabled { color: var(--ink-3); background: var(--bg); }
.input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid var(--hairline);
  background: var(--bg);
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--ink);
}
.info-row {
  text-align: left;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--warn);
  background: rgba(230, 162, 60, 0.1);
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
}
.zone-hint {
  text-align: left;
  font-size: 24rpx;
  color: var(--brand-start);
  background: var(--brand-tint);
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin: -10rpx 0 24rpx;
}

/* ============ 入场按钮 ============ */
.enter-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-deep) 100%);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 32rpx;
  margin-top: 30rpx;
  box-shadow: 0 6rpx 16rpx rgba(91, 141, 239, 0.3);
}

/* ============ 搜索框 ============ */
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--bg);
  border-radius: var(--radius-pill);
  padding: 8rpx 8rpx 8rpx 24rpx;
}
.search-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: transparent;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  border: 2rpx solid var(--hairline);
  box-sizing: border-box;
}
.search-btn {
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-deep) 100%);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  padding: 0 20rpx;
}
.search-hint { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; line-height: 1.5; }
