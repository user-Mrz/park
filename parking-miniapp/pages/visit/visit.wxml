<view class="container">
  <!-- 未登录 -->
  <view class="card" wx:if="{{!isLoggedIn}}">
    <view class="tip">请先登录后使用访客/家长车辆报备功能</view>
    <button class="primary-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <!-- 报备表单 -->
    <view class="card">
      <view class="card-title">访客 / 家长车辆报备</view>

      <view class="form-item">
        <text class="form-label">来访类型</text>
        <picker mode="selector" range="{{visitTypes}}" value="{{visitTypeIndex}}" bindchange="onTypeChange">
          <view class="picker-value">{{visitTypes[visitTypeIndex]}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">来访人</text>
        <input class="form-input" value="{{visitorName}}" placeholder="如 张爸爸（选填）" bindinput="onNameInput" />
      </view>
      <view class="form-item">
        <text class="form-label">来访车牌</text>
        <input class="form-input" value="{{plateNumber}}" placeholder="如 粤B12345" bindinput="onPlateInput" />
      </view>
      <view class="form-item">
        <text class="form-label">来访事由</text>
        <input class="form-input" value="{{purpose}}" placeholder="如 接送学生、家长会（选填）" bindinput="onPurposeInput" />
      </view>
      <view class="form-item">
        <text class="form-label">到校日期</text>
        <picker mode="selector" range="{{dateList}}" value="{{dateIndex}}" bindchange="onDateChange">
          <view class="picker-value">{{startDate}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">到校时间</text>
        <picker mode="selector" range="{{timeList}}" value="{{timeIndex}}" bindchange="onTimeChange">
          <view class="picker-value">{{startTime || '暂无可选时段'}}</view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">预计停留</text>
        <picker mode="selector" range="{{durations}}" range-key="label" value="{{durationIndex}}" bindchange="onDurationChange">
          <view class="picker-value">{{durations[durationIndex].label}}</view>
        </picker>
      </view>

      <view class="tip" wx:if="{{endText}}">预计离校时间：{{endText}}</view>
      <view class="tip">家长接送在访客区可享 {{parentFreeMinutes}} 分钟免费停车，超时按访客费率计费；审核通过后系统自动分配「访客与家长临时停车区」车位。</view>
      <view class="tip warn" wx:if="{{!canReport}}">当前身份尚未通过认证，需先在「账号信息」补全学号/工号并通过管理员审核后才能报备。</view>

      <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting || !canReport}}" bindtap="submit">提交报备</button>
    </view>

    <!-- 我的报备 -->
    <view class="card">
      <view class="card-title">我的报备记录</view>
      <view class="empty-tip" wx:if="{{loadingList}}">加载中…</view>
      <view class="empty-tip" wx:elif="{{reports.length === 0}}">暂无报备记录</view>
      <view class="report-item" wx:for="{{reports}}" wx:key="id">
        <view class="report-head">
          <text class="report-plate">{{item.plateNumber}}</text>
          <text class="report-status {{item.statusCls}}">{{item.statusText}}</text>
        </view>
        <view class="report-line">{{item.typeLabel}}{{item.visitorName ? ' · ' + item.visitorName : ''}}{{item.spotCode ? ' · 车位 ' + item.spotCode : ''}}</view>
        <view class="report-line">预计时段：{{item.rangeText}}</view>
        <view class="report-line" wx:if="{{item.reviewRemark}}">审核意见：{{item.reviewRemark}}</view>
        <view class="report-actions" wx:if="{{item.canCancel}}">
          <text class="cancel-btn" bindtap="cancelReport" data-id="{{item.id}}">撤销报备</text>
        </view>
      </view>
    </view>
  </block>
</view>
