.container { padding: 0 0 30rpx; }

/* ============ Header：品牌渐变 + 装饰圆 + 问候语 + 余额卡 + 余位环 ============ */
.header {
  position: relative;
  background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-mid) 55%, var(--brand-end) 100%);
  padding: 50rpx 40rpx 110rpx;
  color: #fff;
  overflow: hidden;
  border-radius: 0 0 32rpx 32rpx;
}
.header-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}
.header-deco-1 { width: 220rpx; height: 220rpx; top: -60rpx; right: -50rpx; }
.header-deco-2 { width: 140rpx; height: 140rpx; top: 60rpx; right: 100rpx; background: rgba(255, 255, 255, 0.06); }

.header-greeting {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}
.greeting-text { display: block; font-size: 44rpx; font-weight: 600; line-height: 1.3; }
.greeting-sub { display: block; font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }

/* 余额卡 + 余位环 并排（§4.1） */
.header-assets { position: relative; z-index: 1; display: flex; align-items: stretch; gap: 20rpx; }

/* 余额卡片：半透明白底，悬浮在头部上 */
.balance-card {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}
.balance-card-empty { background: rgba(255, 255, 255, 0.15); }
.balance-label { font-size: 24rpx; opacity: 0.85; }
.balance-row { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }
.balance-amount { font-size: 56rpx; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
.balance-action {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--brand-deep);
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.login-tip-text { font-size: 36rpx; }

/* 校园余位环（全端唯一环形图表） */
.ring-wrap {
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
}
.ring-img { width: 120rpx; height: 120rpx; }
.ring-label { font-size: 22rpx; color: rgba(255, 255, 255, 0.92); margin-top: 4rpx; font-variant-numeric: tabular-nums; }

/* ============ Quick Actions：白卡 + 彩色图标徽章（§5.4） ============ */
.actions-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 24rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 2;
}
.action-card {
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 24rpx 8rpx 20rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
  transition: transform 0.15s ease;
}
.action-card:active { transform: scale(0.96); }
.action-card .icon-badge { margin: 0 auto; }
.action-text { font-size: 22rpx; color: var(--ink); font-weight: 500; display: block; margin-top: 12rpx; }

/* ============ Section 区块通用 ============ */
.section { margin: 24rpx 20rpx; }
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: var(--ink);
  display: flex;
  align-items: center;
}
.section-count {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: normal;
  color: #fff;
  background: var(--brand-start);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  line-height: 1.4;
}

/* ============ 当前身份与可见区域提示（RBAC） ============ */
.perm-hint {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, var(--card) 0%, var(--brand-tint) 100%);
  border-radius: var(--radius-card);
  padding: 22rpx 24rpx;
  box-shadow: var(--shadow-card);
  border-left: 8rpx solid var(--brand-start);
}
.perm-hint-icon { font-size: 30rpx; margin-right: 14rpx; line-height: 1.5; }
.perm-hint-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* ============ 潮汐车位入口 ============ */
.tidal-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--card) 0%, var(--brand-tint) 100%);
  border-radius: var(--radius-card);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  border-left: 8rpx solid var(--zone-tidal);
}
.tidal-icon { font-size: 48rpx; margin-right: 20rpx; }
.tidal-body { flex: 1; min-width: 0; }
.tidal-text { font-size: 28rpx; font-weight: 600; color: var(--ink); line-height: 1.5; }
.tidal-sub { font-size: 22rpx; color: var(--ink-2); margin-top: 6rpx; }
.tidal-arrow { font-size: 40rpx; color: var(--zone-tidal); margin-left: 12rpx; }

/* ============ 在场车辆卡片 ============ */
.parking-card {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.parking-card-bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, var(--brand-start) 0%, var(--brand-end) 100%);
}
.parking-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
  margin-bottom: 18rpx;
  border-bottom: 1rpx dashed var(--hairline);
}
/* .plate-badge / .spot-badge 外观由全局类接管 */
.parking-info-grid { display: flex; flex-wrap: wrap; }
.parking-info-item {
  width: 50%;
  padding: 6rpx 0;
  box-sizing: border-box;
}
.parking-info-item:nth-child(odd) { padding-right: 12rpx; }
.info-item-highlight { width: 100%; margin-top: 6rpx; padding-top: 12rpx; border-top: 1rpx solid var(--hairline); }
.info-label { display: block; font-size: 22rpx; color: var(--ink-3); margin-bottom: 4rpx; }
.info-value { display: block; font-size: 26rpx; color: var(--ink); }
.info-value-highlight { color: var(--warn); font-weight: 600; font-size: 30rpx; }

/* ============ 预约卡片 ============ */
.reserve-card {
  position: relative;
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 24rpx 60rpx 24rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.reserve-card-bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 8rpx;
  background: var(--warn);
}
.reserve-card-body { position: relative; z-index: 1; }
.reserve-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.reserve-no { font-size: 26rpx; color: var(--ink-2); font-weight: 500; }
.reserve-detail { font-size: 24rpx; color: var(--ink-2); margin-top: 6rpx; line-height: 1.5; }
.reserve-time { color: var(--brand-deep); font-weight: 500; }
.reserve-amount-row {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed var(--hairline);
}
.reserve-amount-label { font-size: 22rpx; color: var(--ink-3); margin-right: 10rpx; }
.reserve-amount { font-size: 32rpx; font-weight: 600; color: var(--danger); font-variant-numeric: tabular-nums; }
.reserve-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: var(--radius-pill); }
.status-0 { color: var(--info); background: rgba(144, 147, 153, 0.12); }
.status-1 { color: var(--warn); background: rgba(230, 162, 60, 0.1); }
.status-2 { color: var(--ok); background: rgba(52, 179, 126, 0.1); }
.status-3 { color: var(--danger); background: rgba(245, 108, 108, 0.1); }
.status-4 { color: var(--info); background: rgba(144, 147, 153, 0.12); }
.reserve-arrow { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: var(--ink-3); }

/* ============ 全部车位入口卡片（品牌入口卡，§5.2） ============ */
.spots-entry-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-mid) 55%, var(--brand-end) 100%);
  border-radius: var(--radius-card);
  padding: 28rpx 24rpx;
  color: #fff;
  box-shadow: var(--shadow-float);
  transition: transform 0.15s ease;
}
.spots-entry-card:active { transform: scale(0.97); }
.spots-entry-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.spots-entry-body { flex: 1; min-width: 0; }
.spots-entry-title { font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.spots-entry-desc { font-size: 22rpx; opacity: 0.9; margin-top: 6rpx; line-height: 1.5; }
.spots-entry-arrow { font-size: 40rpx; opacity: 0.8; margin-left: 12rpx; }

/* ============ 空状态：带图标 ============ */
.empty {
  text-align: center;
  color: var(--ink-3);
  padding: 40rpx 0;
  font-size: 26rpx;
}
.empty-with-icon { padding: 60rpx 0; }
.empty-icon { font-size: 72rpx; opacity: 0.6; margin-bottom: 16rpx; }
.empty-text { font-size: 26rpx; color: var(--ink-3); }

/* ============ 未登录引导 ============ */
.login-tip {
  background: linear-gradient(135deg, var(--card) 0%, var(--brand-tint) 100%);
  border-radius: var(--radius-card);
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
}
.tip-icon { font-size: 80rpx; }
.tip-title { font-size: 32rpx; font-weight: 600; color: var(--ink); margin-top: 16rpx; }
.tip-desc { font-size: 24rpx; color: var(--ink-2); line-height: 1.6; margin: 12rpx 0 30rpx; }
/* 按钮外观由全局 .btn-primary 接管，此处只留布局 */
.tip-btn { width: 320rpx; }
