.container { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.card-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.tip { font-size: 24rpx; color: #999; line-height: 1.7; padding: 8rpx 0; }
.primary-btn { width: 100%; background: #007AFF; color: #fff; border-radius: 12rpx; font-size: 30rpx; margin-top: 10rpx; }

.violation-item { border-top: 1rpx solid #f5f5f5; padding: 22rpx 0; }
.violation-item:first-of-type { border-top: 1rpx solid #f5f5f5; }
.item-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.item-plate { font-size: 30rpx; font-weight: bold; color: #333; }
.item-status { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 20rpx; }
.item-status.pending { background: #FFF4E6; color: #E6A23C; }
.item-status.done { background: #E8F8EE; color: #52C41A; }
.item-line { font-size: 24rpx; color: #666; line-height: 1.8; }
