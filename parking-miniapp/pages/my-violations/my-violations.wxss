.container { padding: 20rpx; }
.card { background: var(--card); border-radius: var(--radius-card); padding: 28rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-card); }
.card-title { font-size: 30rpx; font-weight: 600; color: var(--ink); margin-bottom: 16rpx; }
.tip { font-size: 24rpx; color: var(--ink-3); line-height: 1.7; padding: 8rpx 0; }
.primary-btn { width: 100%; margin-top: 10rpx; }

.violation-item { border-top: 1rpx solid var(--hairline); padding: 22rpx 0; }
.violation-item:first-of-type { border-top: 1rpx solid var(--hairline); }
.item-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.item-plate { font-size: 30rpx; font-weight: 600; color: var(--ink); letter-spacing: 2rpx; font-variant-numeric: tabular-nums; }
.item-status { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: var(--radius-pill); }
.item-status.pending { background: rgba(230, 162, 60, 0.1); color: var(--warn); }
.item-status.done { background: rgba(52, 179, 126, 0.1); color: var(--ok); }
.item-line { font-size: 24rpx; color: var(--ink-2); line-height: 1.8; }
