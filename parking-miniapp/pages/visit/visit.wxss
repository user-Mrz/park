.container { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; }
.card-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.form-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-label { width: 150rpx; font-size: 28rpx; color: #666; }
.form-input { flex: 1; font-size: 28rpx; color: #333; }
.picker-value { font-size: 28rpx; color: #333; }
.tip { font-size: 22rpx; color: #999; line-height: 1.6; margin: 14rpx 0 4rpx; }
.tip.warn { color: #E6A23C; }
.primary-btn { width: 100%; background: #007AFF; color: #fff; border-radius: 12rpx; font-size: 30rpx; margin-top: 20rpx; }

.empty-tip { font-size: 26rpx; color: #999; text-align: center; padding: 30rpx 0; }
.report-item { border-top: 1rpx solid #f5f5f5; padding: 20rpx 0; }
.report-item:first-child { border-top: none; }
.report-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.report-plate { font-size: 30rpx; font-weight: bold; color: #333; }
.report-status { font-size: 22rpx; padding: 2rpx 12rpx; border-radius: 20rpx; background: #f0f2f5; color: #909399; }
.report-status.pending { background: #FFF4E6; color: #E6A23C; }
.report-status.ok { background: #E8F8EE; color: #52C41A; }
.report-status.error { background: #FDEDED; color: #F56C6C; }
.report-line { font-size: 24rpx; color: #666; line-height: 1.7; }
.report-actions { margin-top: 10rpx; text-align: right; }
.cancel-btn { font-size: 24rpx; color: #F56C6C; }
