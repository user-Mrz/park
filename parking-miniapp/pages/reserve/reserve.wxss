.container { padding: 24rpx; }

/* ============ 加载/错误状态卡片 ============ */
.status-box {
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 80rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.loading-text { font-size: 28rpx; color: var(--ink-2); }
.error-text { font-size: 28rpx; color: var(--danger); margin-bottom: 30rpx; }
.retry-btn {
  width: 200rpx; height: 64rpx; line-height: 64rpx;
  background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-deep) 100%);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
}

/* ============ 表单卡片 ============ */
.form-card {
  background: var(--card);
  border-radius: var(--radius-card);
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* ============ 校园身份提示 ============ */
.campus-bar {
  font-size: 22rpx;
  line-height: 1.6;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.campus-bar.ok {
  background: linear-gradient(135deg, rgba(52, 179, 126, 0.08) 0%, rgba(52, 179, 126, 0.14) 100%);
  color: var(--ok);
  border-left: 4rpx solid var(--ok);
}
.campus-bar.warn {
  background: linear-gradient(135deg, rgba(230, 162, 60, 0.08) 0%, rgba(230, 162, 60, 0.14) 100%);
  color: var(--warn);
  border-left: 4rpx solid var(--warn);
}

/* ============ 表单标题：左竖线装饰 ============ */
.form-title {
  position: relative;
  font-size: 28rpx;
  color: var(--ink);
  margin: 24rpx 0 12rpx;
  padding-left: 16rpx;
  font-weight: 600;
}
.form-title::before {
  content: '';
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  width: 6rpx; height: 24rpx;
  background: linear-gradient(180deg, var(--brand-start) 0%, var(--brand-end) 100%);
  border-radius: 3rpx;
}

/* ============ Picker 选择框 ============ */
.picker-view {
  height: 88rpx;
  line-height: 88rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
  border: 1rpx solid transparent;
  transition: border-color 0.2s;
}
.picker-view.disabled { color: var(--ink-3); background: #FAFAFB; }

/* ============ 时间提示 / 潮汐提示 ============ */
.time-hint { font-size: 22rpx; color: var(--ink-3); margin-top: 10rpx; line-height: 1.5; }
.tidal-bar {
  font-size: 22rpx;
  line-height: 1.6;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
  background: linear-gradient(135deg, var(--brand-tint) 0%, rgba(91, 141, 239, 0.12) 100%);
  color: #2B6CB0;
  border-left: 4rpx solid var(--brand-start);
}

/* ============ 费用预览 ============ */
.fee-preview {
  text-align: center;
  margin: 30rpx 0 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(245, 108, 108, 0.06) 0%, rgba(245, 108, 108, 0.12) 100%);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}
.fee-amount {
  font-size: 56rpx;
  font-weight: bold;
  font-variant-numeric: tabular-nums;
  color: var(--danger);
  margin-left: 8rpx;
}

/* ============ 提交按钮（外观由全局 .btn-primary 提供，此处仅布局） ============ */
.submit-btn {
  width: 100%;
  margin-top: 30rpx;
}
.submit-btn[disabled] {
  opacity: 0.5;
}

/* ============ 搜索框 ============ */
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 10rpx 0;
  background: #F7F8FA;
  border-radius: var(--radius-pill);
  padding: 8rpx 8rpx 8rpx 24rpx;
}
.search-input {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  background: transparent;
  font-size: 28rpx;
  color: var(--ink);
}
.search-btn {
  min-width: 120rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-deep) 100%);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  padding: 0 20rpx;
}
.search-hint { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; line-height: 1.5; }
