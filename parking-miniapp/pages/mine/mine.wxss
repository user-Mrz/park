.container { padding-bottom: 40rpx; }

/* 品牌页头（§5.1） */
.header { position: relative; overflow: hidden; border-radius: 0 0 32rpx 32rpx; padding: 56rpx 30rpx 104rpx; }
.header-deco { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.08); }
.header-deco-1 { width: 280rpx; height: 280rpx; top: -100rpx; right: -80rpx; }
.header-deco-2 { width: 180rpx; height: 180rpx; top: 48rpx; right: 120rpx; }
.header-user { position: relative; display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 110rpx; height: 110rpx; background: rgba(255, 255, 255, 0.2); border: 3rpx solid rgba(255, 255, 255, 0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 52rpx; flex-shrink: 0; box-sizing: border-box; }
.avatar-img { width: 110rpx; height: 110rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.25); border: 3rpx solid rgba(255, 255, 255, 0.4); flex-shrink: 0; box-sizing: border-box; }
.user-info { flex: 1; min-width: 0; }
.card-arrow { font-size: 44rpx; color: rgba(255, 255, 255, 0.8); }
.nickname { display: block; font-size: 38rpx; color: #fff; font-weight: 600; }
.phone { display: block; font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 6rpx; }

/* 余额浮层卡：上移与页头重叠 */
.balance-card { position: relative; margin: -60rpx 20rpx 20rpx; display: flex; align-items: center; justify-content: space-between; }
.balance-label { display: block; font-size: 22rpx; color: var(--ink-3); margin-bottom: 8rpx; }
.balance-num { display: block; color: var(--ink); }
.recharge-btn { padding: 14rpx 48rpx; font-size: 26rpx; flex-shrink: 0; }

/* 用户角色与可见停车区域卡片（RBAC）：语义条卡 */
.perm-card {
  margin: 0 20rpx 20rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, var(--card) 0%, var(--brand-tint) 100%);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  border-left: 8rpx solid var(--brand-start);
}
.perm-card-title { font-size: 26rpx; font-weight: 600; color: var(--ink); margin-bottom: 16rpx; }
.perm-row { display: flex; align-items: flex-start; justify-content: space-between; padding: 8rpx 0; }
.perm-label { font-size: 26rpx; color: var(--ink-2); flex-shrink: 0; margin-right: 20rpx; }
.perm-value { font-size: 26rpx; color: var(--ink); font-weight: 500; text-align: right; flex: 1; min-width: 0; line-height: 1.5; }

/* 菜单白卡分组（20rpx + 图标徽章） */
.menu-list { background: var(--card); border-radius: var(--radius-card); margin: 0 20rpx; overflow: hidden; box-shadow: var(--shadow-card); }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 28rpx; border-bottom: 1rpx solid var(--hairline); }
.menu-item:last-child { border-bottom: none; }
.menu-left { display: flex; align-items: center; gap: 20rpx; font-size: 30rpx; color: var(--ink); }
.arrow { font-size: 36rpx; color: var(--ink-3); }
.logout-text { color: var(--danger); }
.login-text { color: var(--brand-deep); font-weight: 500; }
