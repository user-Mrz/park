.container { padding: 30rpx; }
.exit-card { background: var(--card); border-radius: var(--radius-card); padding: 50rpx 30rpx; text-align: center; }
.icon-area { font-size: 100rpx; margin-bottom: 10rpx; }
.title { font-size: 36rpx; font-weight: bold; color: var(--ink); margin-bottom: 30rpx; }
.info-box { text-align: left; margin-bottom: 30rpx; }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--hairline); font-size: 28rpx; }
.info-label { color: var(--ink-3); }
.highlight { color: var(--warn); font-weight: bold; }
.fee-row { margin-top: 10rpx; }
.fee { font-size: 56rpx; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--danger); }
.settle-note { background: var(--brand-tint); color: var(--brand-deep); padding: 16rpx; border-radius: var(--radius-card); font-size: 26rpx; margin-bottom: 20rpx; }
.warning { background: rgba(245, 108, 108, 0.1); color: var(--danger); padding: 16rpx; border-radius: var(--radius-card); font-size: 26rpx; margin-bottom: 20rpx; }
.exit-btn { width: 100%; background: var(--danger); color: #fff; border-radius: var(--radius-pill); font-size: 32rpx; }
.exit-btn[disabled] { opacity: 0.5; }
