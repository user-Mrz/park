.login-container { min-height: 100vh; background: var(--bg); padding-bottom: 60rpx; box-sizing: border-box; }

/* 品牌页头（§5.1） */
.login-header { position: relative; overflow: hidden; border-radius: 0 0 32rpx 32rpx; padding: 88rpx 40rpx 120rpx; text-align: center; }
.header-deco { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.08); }
.header-deco-1 { width: 260rpx; height: 260rpx; top: -90rpx; right: -70rpx; }
.header-deco-2 { width: 170rpx; height: 170rpx; top: 60rpx; right: 110rpx; }
.app-logo { position: relative; font-size: 88rpx; margin-bottom: 16rpx; }
.app-name { position: relative; font-size: 40rpx; font-weight: 600; color: #fff; letter-spacing: 2rpx; }
.app-desc { position: relative; font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 10rpx; letter-spacing: 4rpx; }

/* 表单卡上移与页头重叠 */
.login-card { position: relative; margin: -60rpx 24rpx 0; background: var(--card); border-radius: var(--radius-card); box-shadow: var(--shadow-card); padding: 48rpx 36rpx; box-sizing: border-box; }

/* 表单（§5.7）：hairline 底部分隔线 */
.input-group { margin-bottom: 8rpx; }
.input { width: 100%; height: 88rpx; border-bottom: 1rpx solid var(--hairline); padding: 0 8rpx; font-size: 28rpx; color: var(--ink); box-sizing: border-box; }
.picker-input { height: 88rpx; line-height: 88rpx; border-bottom: 1rpx solid var(--hairline); padding: 0 8rpx; font-size: 28rpx; color: var(--ink); box-sizing: border-box; }

.captcha-row { display: flex; gap: 16rpx; align-items: center; margin: 8rpx 0 24rpx; }
.captcha-input { flex: 1; }
.captcha-img { width: 200rpx; height: 80rpx; border-radius: var(--radius-badge); border: 1rpx solid var(--hairline); }
.captcha-placeholder { width: 200rpx; height: 80rpx; border-radius: var(--radius-badge); border: 1rpx dashed #C7D2E8; display: flex; align-items: center; justify-content: center; font-size: 24rpx; color: var(--ink-3); background: var(--brand-tint); }

/* 登录按钮：外观由全局 .btn-primary 接管，此处只留布局 */
.login-btn { width: 100%; margin-top: 24rpx; }

.switch-row { text-align: center; margin-top: 28rpx; font-size: 26rpx; color: var(--ink-2); }
.link { color: var(--brand-deep); margin-left: 8rpx; font-weight: 500; }

.divider { display: flex; align-items: center; margin: 40rpx 0 24rpx; }
.divider::before, .divider::after { content: ''; flex: 1; height: 1rpx; background: var(--hairline); }
.divider text { padding: 0 20rpx; color: var(--ink-3); font-size: 24rpx; }

/* 微信按钮：第三方品牌绿保留，pill 化 */
.wechat-btn { width: 100%; background: #07C160; color: #fff; border-radius: var(--radius-pill); font-size: 28rpx; font-weight: 500; transition: transform 0.15s ease, opacity 0.15s ease; }
.wechat-btn:active { transform: scale(0.97); opacity: 0.9; }
.wechat-btn::after { border: none; }

.bind-tip { margin-top: 16rpx; font-size: 22rpx; color: var(--ink-3); text-align: center; line-height: 1.5; }
