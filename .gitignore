# ===== 依赖与构建产物（不入库）=====
node_modules/
parking-admin/node_modules/
.pnpm-store/
parking-server/target/
parking-admin/dist/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ===== 本地上传文件（用户头像、公告附件等，含个人信息与业务文件，勿提交）=====
parking-server/uploads/*
!parking-server/uploads/.gitignore
# 公告附件目录：只保留目录占位文件，附件本身不入库
!parking-server/uploads/announcement/
parking-server/uploads/announcement/*
!parking-server/uploads/announcement/.gitkeep

# ===== 日志与临时文件 =====
*.log
logs/
run*.log
*.tmp
*.bak

# ===== 本地数据库/缓存快照（数据库数据不入库）=====
*.rdb
*.sql.bak
dump.rdb
stress-test/users.json
stress-test/users.sql
stress-test/snapshot.sql
stress-test/results.json
stress-test/e2e-results.json

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 个人资料与本机信息（不入库）=====
# 毕业设计论文、开题报告、图集等个人文档
文本内容/
# 数据库全量导出（含真实运行数据、日志与账号记录，仅作本地备份）
docs/parking_system.sql
docs/*-dump.sql
# 本机截图 / 临时产物
.screenshots/
# 本机运行时产物
*.pid
*.hprof
parking-server/logs/
