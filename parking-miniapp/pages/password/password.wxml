<view class="container">
  <view class="card">
    <view class="card-title">修改登录密码</view>

    <view class="form-item">
      <text class="form-label">原密码</text>
      <input class="form-input" password placeholder="请输入当前密码" value="{{oldPassword}}" data-field="oldPassword" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">新密码</text>
      <input class="form-input" password maxlength="20" placeholder="6-20 位新密码" value="{{newPassword}}" data-field="newPassword" bindinput="onInput" />
    </view>

    <view class="form-item">
      <text class="form-label">确认密码</text>
      <input class="form-input" password maxlength="20" placeholder="请再次输入新密码" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" />
    </view>

    <view class="tip">密码长度 6-20 位，建议包含字母与数字；修改成功后需要重新登录。</view>

    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">确认修改</button>
  </view>
</view>
