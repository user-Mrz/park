.container { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 28rpx; }
.card-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.form-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.form-label { width: 150rpx; font-size: 28rpx; color: #666; }
.form-input { flex: 1; font-size: 28rpx; color: #333; }
.tip { font-size: 22rpx; color: #999; line-height: 1.6; margin: 20rpx 0 10rpx; }
.primary-btn { width: 100%; background: #007AFF; color: #fff; border-radius: 12rpx; font-size: 30rpx; margin-top: 20rpx; }
