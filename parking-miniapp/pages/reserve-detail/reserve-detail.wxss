.container { padding: 0 0 40rpx; }
.status-box { background: var(--card); border-radius: var(--radius-card); padding: 80rpx 30rpx; margin: 30rpx; text-align: center; }
.loading-text { font-size: 28rpx; color: var(--ink-3); }
.error-text { font-size: 28rpx; color: var(--danger); margin-bottom: 30rpx; }
.back-btn { width: 240rpx; height: 72rpx; line-height: 72rpx; background: var(--card); color: var(--brand-deep); border: 1rpx solid var(--brand-start); border-radius: var(--radius-pill); font-size: 28rpx; }

/* 状态卡片 */
.status-card { margin: 30rpx; border-radius: 20rpx; padding: 50rpx 30rpx; text-align: center; color: #fff; }
.status-bg-0 { background: linear-gradient(135deg, var(--info), #b0b3b8); }
.status-bg-1 { background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-mid) 55%, var(--brand-end) 100%); }
.status-bg-2 { background: linear-gradient(135deg, var(--ok), #85ce61); }
.status-bg-3 { background: linear-gradient(135deg, var(--danger), #f89898); }
.status-bg-4 { background: linear-gradient(135deg, var(--warn), #ebb563); }
.status-icon { font-size: 72rpx; margin-bottom: 12rpx; }
.status-label { font-size: 40rpx; font-weight: bold; }
.status-hint { font-size: 26rpx; opacity: 0.85; margin-top: 12rpx; }

/* 信息卡片 */
.info-card { background: var(--card); border-radius: var(--radius-card); margin: 0 30rpx 30rpx; padding: 30rpx; box-shadow: var(--shadow-card); }
.card-title { font-size: 32rpx; font-weight: bold; color: var(--ink); margin-bottom: 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--hairline); }
.info-row { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 28rpx; }
.info-label { color: var(--ink-3); }
.info-value { color: var(--ink); }
.fee-row { margin-top: 8rpx; padding-top: 20rpx; border-top: 1rpx solid var(--hairline); }
.fee { font-size: 36rpx; font-weight: bold; color: var(--danger); }

/* 操作按钮 */
.actions { margin: 0 30rpx; display: flex; flex-direction: column; gap: 20rpx; }
.action-btn { width: 100%; height: 96rpx; line-height: 96rpx; border-radius: var(--radius-pill); font-size: 32rpx; font-weight: bold; }
.enter-btn { background: linear-gradient(135deg, var(--brand-start) 0%, var(--brand-mid) 55%, var(--brand-end) 100%); color: #fff; }
.cancel-btn { background: var(--card); color: var(--danger); border: 2rpx solid var(--danger); }
.footnote { text-align: center; padding: 30rpx; font-size: 24rpx; color: var(--ink-3); }
