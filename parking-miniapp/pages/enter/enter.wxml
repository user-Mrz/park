<view class="container">
  <view class="enter-card">
    <view class="icon-area">🚗</view>
    <view class="title">车辆入场</view>
    <view class="desc">确认进入停车场</view>

    <!-- 活动预约提示 -->
    <view class="reservation-hint" wx:if="{{activeReservation}}">
      <text>📌 您有活动预约：{{activeReservation.reservationNo}}</text>
      <text class="hint-sub" wx:if="{{activeSpotCode}}">已自动选中预约车位 {{activeSpotCode}}，确认入场将自动关联预约</text>
      <text class="hint-sub" wx:else>确认入场时将自动关联该预约</text>
    </view>

    <view class="form-item">
      <text class="label">搜索车位</text>
      <view class="search-box">
        <input class="search-input" placeholder="输入车位编号 / 区域 / 分区名" value="{{spotKeyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSpotSearch"/>
        <view class="search-btn" bindtap="onSpotSearch">搜索</view>
      </view>
      <view class="search-hint" wx:if="{{spotKeyword}}">已匹配 {{searchMatched}} 个车位{{searchMatched === 0 ? '，请尝试其他关键字' : '，可在下方区域中选择'}}</view>
    </view>

    <view class="form-item">
      <text class="label">选择停车区域</text>
      <picker mode="selector" range="{{zones}}" range-key="label" bindchange="onZoneChange">
        <view class="picker-view">{{selectedZone ? selectedZone.label : '请选择停车区域（如：图书馆区）'}}</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="label">选择车位</text>
      <picker mode="selector" range="{{zoneSpots}}" range-key="label" bindchange="onSpotChange" disabled="{{!selectedZone}}">
        <view class="picker-view {{selectedZone ? '' : 'disabled'}}">{{selectedSpot ? selectedSpot.label : (selectedZone ? '请选择车位' : '请先选择停车区域')}}</view>
      </picker>
    </view>

    <view class="zone-hint" wx:if="{{selectedZone}}">{{selectedZone.name}} 共 {{selectedZone.count}} 个空闲车位 · {{selectedZone.priceText}}</view>

    <view class="form-item">
      <text class="label">车牌号</text>
      <input class="input" value="{{plateNumber}}" placeholder="请输入车牌号" bindinput="onInput" data-field="plateNumber"/>
    </view>

    <view class="info-row" wx:if="{{selectedSpot}}">
      <text>费率：¥{{selectedSpot.pricePerHour}}/小时</text>
    </view>

    <button class="enter-btn" bindtap="handleEnter" loading="{{submitting}}">确认入场</button>
  </view>
</view>
