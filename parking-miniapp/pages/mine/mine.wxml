<view class="container">
  <view class="user-card">
    <view class="avatar">👤</view>
    <view class="user-info" wx:if="{{isLoggedIn}}">
      <text class="nickname">{{userInfo.nickname || '用户'}}</text>
      <text class="phone">{{userInfo.phone || ''}}</text>
    </view>
    <view class="user-info" wx:else>
      <text class="nickname">未登录</text>
      <text class="phone">点击登录使用更多功能</text>
    </view>
  </view>

  <view class="balance-bar" wx:if="{{isLoggedIn}}">
    <text>账户余额</text>
    <text class="balance-num">¥{{userInfo.balance || '0.00'}}</text>
    <text class="recharge-link" bindtap="goPage" data-url="/pages/recharge/recharge">充值</text>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goPage" data-url="/pages/reserve/reserve"><text>📅 预约车位</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/enter/enter"><text>🚗 车辆入场</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/exit/exit"><text>🏁 车辆离场</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/record/record"><text>📋 停车记录</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/record/record?tab=1"><text>💰 充值记录</text><text class="arrow">›</text></view>
  </view>

  <view class="menu-list" style="margin-top: 20rpx;">
    <view class="menu-item" bindtap="handleLogout" wx:if="{{isLoggedIn}}"><text style="color:#F56C6C">🚪 退出登录</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goPage" data-url="/pages/login/login" wx:else><text style="color:#007AFF">🔑 登录/注册</text><text class="arrow">›</text></view>
  </view>
</view>
