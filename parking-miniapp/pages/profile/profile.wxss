.container { padding: 0 20rpx 40rpx; }

/* 顶部头像卡：品牌页头（§5.1） */
.head-card {
  position: relative;
  overflow: hidden;
  border-radius: 0 0 32rpx 32rpx;
  padding: 56rpx 30rpx 44rpx;
  margin: 0 -20rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.header-deco { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.08); }
.header-deco-1 { width: 260rpx; height: 260rpx; top: -100rpx; right: -70rpx; }
.header-deco-2 { width: 170rpx; height: 170rpx; top: 40rpx; right: 120rpx; }
.avatar-wrap { position: relative; width: 120rpx; height: 120rpx; flex-shrink: 0; }
.avatar-img { width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.25); }
.avatar-emoji {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx;
}
.avatar-mask {
  position: absolute; left: 0; right: 0; bottom: 0;
  height: 34rpx; line-height: 34rpx; text-align: center;
  font-size: 20rpx; color: #fff;
  background: rgba(0, 0, 0, 0.35);
  border-bottom-left-radius: 60rpx; border-bottom-right-radius: 60rpx;
}
.head-info { position: relative; flex: 1; min-width: 0; }
.head-nickname { display: block; font-size: 36rpx; font-weight: 600; color: #fff; }
.head-sub { display: block; font-size: 24rpx; color: rgba(255, 255, 255, 0.85); margin-top: 6rpx; }

/* 通用卡片 */
.card { background: var(--card); border-radius: var(--radius-card); box-shadow: var(--shadow-card); padding: 28rpx; margin-bottom: 20rpx; }
.card-title { font-size: 30rpx; font-weight: 600; color: var(--ink); margin-bottom: 20rpx; }

/* 表单 */
.form-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--hairline); }
.form-label { width: 140rpx; font-size: 28rpx; color: var(--ink-2); }
.form-input { flex: 1; font-size: 28rpx; color: var(--ink); }
.tip { font-size: 22rpx; color: var(--ink-3); line-height: 1.6; margin: 18rpx 0 6rpx; }

/* 主按钮外观由全局 .primary-btn/.btn-primary 接管，此处只留布局 */
.primary-btn { width: 100%; margin-top: 16rpx; }
/* 危险次操作：白底 + danger 描边 + 胶囊 */
.ghost-btn { width: 100%; background: var(--card); color: var(--danger); border: 1rpx solid var(--danger); border-radius: var(--radius-pill); font-size: 28rpx; margin-top: 16rpx; transition: transform 0.15s ease, opacity 0.15s ease; }
.ghost-btn:active { transform: scale(0.97); opacity: 0.85; }
.ghost-btn::after { border: none; }

/* 只读信息 */
.info-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--hairline); font-size: 28rpx; }
.info-row:last-child { border-bottom: none; }
.info-label { color: var(--ink-2); }
.info-value { color: var(--ink); }

/* 链接行 */
.link-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; font-size: 30rpx; color: var(--ink); }
.arrow { font-size: 36rpx; color: var(--ink-3); }
.bind-status { font-size: 26rpx; color: var(--ink-3); }
.bind-status.on { color: var(--ok); }

/* 身份状态徽标：语义色浅底（§5.5） */
.badge { font-size: 22rpx; font-weight: 500; padding: 4rpx 14rpx; border-radius: var(--radius-pill); margin-left: 12rpx; }
.badge.ok { background: rgba(52, 179, 126, 0.1); color: var(--ok); }
.badge.pending { background: rgba(230, 162, 60, 0.1); color: var(--warn); }
.picker-value { font-size: 28rpx; color: var(--ink); }
