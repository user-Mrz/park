.container { padding: 20rpx; }
.card { background: var(--card); border-radius: var(--radius-card); padding: 28rpx; box-shadow: var(--shadow-card); }
.card-title { font-size: 30rpx; font-weight: 600; color: var(--ink); margin-bottom: 20rpx; }
.form-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--hairline); }
.form-label { width: 150rpx; font-size: 28rpx; color: var(--ink-2); }
.form-input { flex: 1; font-size: 28rpx; color: var(--ink); }
.tip { font-size: 22rpx; color: var(--ink-3); line-height: 1.6; margin: 20rpx 0 10rpx; }
.primary-btn { width: 100%; margin-top: 20rpx; }
