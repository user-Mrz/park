.container { padding: 20rpx; }
.tabs { display: flex; background: var(--card); border-radius: var(--radius-card); margin-bottom: 20rpx; overflow: hidden; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: var(--ink-2); }
.tab-item.active { color: var(--brand-start); font-weight: bold; border-bottom: 4rpx solid var(--brand-start); }
.record-card { background: var(--card); border-radius: var(--radius-card); padding: 24rpx; margin-bottom: 16rpx; }
.record-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.plate { font-size: 30rpx; font-weight: bold; }
.status { font-size: 26rpx; color: var(--warn); }
.record-row { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 26rpx; }
.rl { color: var(--ink-3); }
.fee-text { color: var(--danger); font-weight: bold; }
.amount-in { color: var(--ok); font-weight: bold; }
.amount-out { color: var(--danger); font-weight: bold; }
.empty { text-align: center; color: var(--ink-3); padding: 80rpx 0; font-size: 26rpx; }
