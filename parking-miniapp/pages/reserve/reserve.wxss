.container { padding: 30rpx; }
.status-box { background: #fff; border-radius: 16rpx; padding: 80rpx 30rpx; text-align: center; }
.loading-text { font-size: 28rpx; color: #999; }
.error-text { font-size: 28rpx; color: #F56C6C; margin-bottom: 30rpx; }
.retry-btn { width: 200rpx; height: 64rpx; line-height: 64rpx; background: #007AFF; color: #fff; border-radius: 32rpx; font-size: 26rpx; }
.form-card { background: #fff; border-radius: 16rpx; padding: 30rpx; }
.form-title { font-size: 28rpx; color: #666; margin: 20rpx 0 10rpx; }
.picker-view { height: 88rpx; line-height: 88rpx; background: #f8f8f8; border-radius: 12rpx; padding: 0 24rpx; font-size: 28rpx; color: #333; }
.fee-preview { text-align: center; margin: 30rpx 0; font-size: 30rpx; }
.fee-amount { font-size: 48rpx; font-weight: bold; color: #F56C6C; }
.submit-btn { width: 100%; background: #007AFF; color: #fff; border-radius: 12rpx; font-size: 32rpx; margin-top: 20rpx; }
.submit-btn[disabled] { opacity: 0.5; }
.time-hint { font-size: 22rpx; color: #999; margin-top: 10rpx; line-height: 1.5; }
.campus-bar { font-size: 22rpx; line-height: 1.6; padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.campus-bar.ok { background: #E8F8EE; color: #2f9e5b; }
.campus-bar.warn { background: #FFF4E6; color: #d18b1f; }
